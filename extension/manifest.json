{
  "manifest_version": 3,
  "name": "AI Hallucination Detector",
  "version": "1.0.0",
  "description": "Verify factual claims in AI prompts and model responses against Wikipedia.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}
